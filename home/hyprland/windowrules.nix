        "keep_aspect_ratio on, match:title ^(Picture-in-Picture)$"
        "no_blur on, match:tag games"
        "fullscreen on, match:tag games"
      ];
    };

    extraConfig = "
      monitor=,preferred,auto,auto
    ";
  };
